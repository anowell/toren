#!/usr/bin/env bash
# breq complete [workspace] — mark the workspace's tasks done, then destroy it
#
# This is a plain script on your PATH, not a breq subcommand: `breq complete` finds it by
# name and hands it the arguments. Edit it. It is meant to be edited — the per-source status
# values below are defaults, not a vocabulary breq imposes.
#
# The destroy comes last on purpose: if it refuses because something is still running in
# there, the tasks are already closed and `breq destroy <ws> --kill` finishes the job.

set -euo pipefail

case "${1:-}" in
    -h|--help)
        echo "usage: breq complete [workspace]"
        echo
        echo "Mark the workspace's linked tasks done, then destroy the workspace."
        exit 0
        ;;
esac

ws="${1:-${TOREN_WORKSPACE:-}}"
if [ -z "$ws" ]; then
    echo "usage: breq complete <workspace>" >&2
    exit 2
fi
if [ "${ws#-}" != "$ws" ]; then
    echo "breq complete: unknown option '$ws'" >&2
    exit 2
fi

links=$(breq get "$ws" task || true)
if [ -z "$links" ]; then
    echo "No tasks linked to '$ws'. Link one with: breq set $ws +task <source>:<id>" >&2
    exit 1
fi

for link in $links; do
    source="${link%%:*}"
    case "$source" in
        runes)  status="done" ;;
        github) status="closed" ;;
        linear) status="Done" ;;
        beads)  status="closed" ;;
        *)      status="done" ;;
    esac

    breq set "$ws" task.status "$status" --task "$link"
    echo "$link -> $status"
done

breq destroy "$ws"
