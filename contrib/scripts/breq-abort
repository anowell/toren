#!/usr/bin/env bash
# breq abort [workspace] — hand the workspace's tasks back, then destroy it
#
# A plain PATH script, like breq-complete. Leaves each linked task in your tracker's
# "started but nobody on it" state — work-in-progress, assignee dropped — so whoever picks
# it up next can see it was already begun. Then the place goes away.
#
# The work in the workspace is discarded with it. To keep the working copy, drop breq's
# state only: breq destroy <workspace> --no-delete

set -euo pipefail

case "${1:-}" in
    -h|--help)
        echo "usage: breq abort [workspace]"
        echo
        echo "Set the workspace's linked tasks back to work-in-progress and unassign them,"
        echo "then destroy the workspace."
        exit 0
        ;;
esac

ws="${1:-${TOREN_WORKSPACE:-}}"
if [ -z "$ws" ]; then
    echo "usage: breq abort <workspace>" >&2
    exit 2
fi
if [ "${ws#-}" != "$ws" ]; then
    echo "breq abort: unknown option '$ws'" >&2
    exit 2
fi

links=$(breq get "$ws" task || true)
if [ -z "$links" ]; then
    echo "No tasks linked to '$ws'." >&2
    exit 1
fi

for link in $links; do
    source="${link%%:*}"
    case "$source" in
        runes)  status="wip" ;;
        github) status="open" ;;
        linear) status="In Progress" ;;
        beads)  status="in_progress" ;;
        *)      status="wip" ;;
    esac

    breq set "$ws" task.status "$status" --task "$link"
    breq set "$ws" task.assignee "none" --task "$link" 2>/dev/null || true
    echo "$link -> $status"
done

breq destroy "$ws"
